# Copie para .env e ajuste os valores.

DATABASE_URL="file:./dev.db"

# URL pública do site, usada para montar o link do cardápio digital (/loja/[slug]).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Assina o cookie de sessão do painel admin (HMAC). Gere um valor aleatório forte em produção.
SESSION_SECRET="change-me"

# Credenciais globais (fallback) da WhatsApp Cloud API da Meta. Cada loja pode
# configurar as suas próprias em /admin/settings, que têm prioridade sobre estas.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
