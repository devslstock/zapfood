# Copie para .env e ajuste os valores.

# String de conexão do Postgres (Supabase). Em produção/Vercel, use o
# connection pooler do Supabase (Session pooler, porta 5432) — o host direto
# (db.<projeto>.supabase.co) só resolve em IPv6 e não é alcançável pelo build
# da Vercel.
DATABASE_URL="postgresql://user:password@localhost:5432/zaapfood?schema=public"

# Tamanho máximo do pool de conexões do pg usado pelo Prisma (src/lib/prisma.ts).
# Opcional — sem definir, o padrão do código é 20. Ajuste conforme o limite de
# conexões/Pool Size configurado no seu projeto Supabase.
# DATABASE_POOL_MAX="20"

# URL pública do site, usada para montar o link do cardápio digital (/loja/[slug])
# enquanto ROOT_DOMAIN abaixo não estiver configurado.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Domínio próprio da plataforma (ex: "zaapfood.com"), sem protocolo e sem "www".
# Deixe em branco enquanto não tiver um domínio — o cardápio continua funcionando
# por /loja/[slug]. Ao configurar (+ DNS coringa *.zaapfood.com apontando pro
# deploy), cada loja passa a ter seu próprio link: <slug-da-loja>.zaapfood.com.
ROOT_DOMAIN=""

# Assina o cookie de sessão do painel admin (HMAC). Gere um valor aleatório forte em produção.
SESSION_SECRET="change-me"

# Credenciais globais (fallback) da WhatsApp Cloud API da Meta. Cada loja pode
# configurar as suas próprias em /admin/settings, que têm prioridade sobre estas.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# Envio de e-mail (confirmação de cadastro) via Resend (resend.com). Sem a
# API key, o e-mail só é registrado no log do servidor — útil para testar sem
# configurar nada.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ZaapFood <onboarding@resend.dev>"

# Upload de imagens (logo, capa, fotos de produto) via Supabase Storage.
# 1. No painel do Supabase: Storage → New bucket → marque "Public bucket".
# 2. SUPABASE_URL = a mesma URL do projeto (https://xxxx.supabase.co).
# 3. SUPABASE_SERVICE_ROLE_KEY = Settings → API → service_role (secreta, nunca expor no client).
# Sem essas variáveis, o envio de imagem fica desabilitado (erro claro na tela),
# o resto do cardápio funciona normalmente sem fotos.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="zaapfood-assets"

# Cobrança recorrente (cartão/PIX) das lojas que se cadastram sozinhas em
# /cadastro, via Asaas (asaas.com). Pegue a chave em Asaas > Integrações > API.
# Use a chave de sandbox ($aact_hmlg_...) + ASAAS_BASE_URL de sandbox para
# testar sem cobrar de verdade; troque os dois para produção quando for ao ar.
# IMPORTANTE: escreva "\$" (barra invertida antes do $) no começo da chave —
# o Next.js expande "$algumacoisa" no .env como referência a outra variável
# de ambiente, e toda chave do Asaas começa com "$", então sem escapar ela
# vira uma string vazia e o pagamento quebra com "ASAAS_API_KEY não está configurado".
ASAAS_API_KEY=""
ASAAS_BASE_URL="https://api-sandbox.asaas.com/v3"
# Gere um valor aleatório forte e cadastre a URL
# https://SEU-DOMINIO/api/webhooks/asaas em Asaas > Integrações > Webhooks,
# colando este mesmo valor no campo "Token de autenticação" do webhook.
ASAAS_WEBHOOK_SECRET="change-me"

# reCAPTCHA (Google) no formulário de /cadastro, contra robôs/spam. Crie um
# site em https://www.google.com/recaptcha/admin (tipo "v2 Caixa de seleção
# - Não sou um robô") e cole as duas chaves aqui. Sem RECAPTCHA_SECRET_KEY,
# o captcha some do formulário e o cadastro funciona normalmente sem essa
# proteção — útil para testar sem configurar nada.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Usadas exclusivamente pelo `prisma db seed` (não são lidas pela aplicação em
# runtime) — criam a conta do painel de super-admin (/super-admin) só se ela
# ainda não existir no banco.
PLATFORM_ADMIN_NAME="Administrador ZaapFood"
PLATFORM_ADMIN_EMAIL="admin@zaapfood.app"
PLATFORM_ADMIN_PASSWORD="zaapfood-admin123"
